# ==============================================================================
# Front-Running (AI & Storage Supply-Chain Swing Research Desk) Environment Config
# Copy to .env and edit as needed: cp .env.example .env
# ==============================================================================

# 1. Local RTX 5070 Ti LLM inference endpoint (default: local Ollama on WSL2)
# If running the UI on macOS and connecting to a Windows/WSL2 5070 Ti host,
# set this to http://<desktop-LAN-IP>:11434/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama

# Recommended models for RTX 5070 Ti (16GB GDDR7):
#   - Balanced / recommended:    qwen3:14b or qwen2.5:14b
#   - Deep reasoning (CoT):      deepseek-r1:14b
#   - Highest quality (slower):  qwen2.5:32b-instruct-q4_K_M
LLM_MODEL=qwen3:14b
LLM_TIMEOUT_SEC=180
LLM_TEMPERATURE=0.2

# 2. GPU compute configuration
# auto = auto-detect RTX 5070 Ti CUDA with BF16/FP32 acceleration; cpu = force CPU
COMPUTE_DEVICE=auto
MC_SIMULATIONS=100000

# 3. SEC EDGAR compliance identifier (SEC requires a valid email-format User-Agent; free, no API key needed)
SEC_USER_AGENT=FrontRunningQuantResearch/1.0 (trader@local-research.dev)

# 4. Historical market data lookback in years (default: 10 years for GPU analog search & Walk-Forward ML)
HISTORY_YEARS=10

# 5. Data, reports, and database paths
DATA_DIR=data
REPORTS_DIR=reports
DB_PATH=data/trading_desk.db
