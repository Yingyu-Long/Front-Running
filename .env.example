# ==============================================================================
# Front-Running (AI & 存储产业链波段投研驾驶舱) 环境变量配置
# 复制为 .env 后按需修改: cp .env.example .env
# ==============================================================================

# 1. 本地 RTX 5070 Ti LLM 推理服务 (默认 WSL2 本机 Ollama)
# 如果你在 Mac 上跑界面、连 Windows/WSL2 的 5070 Ti，可改为 http://<台式机局域网IP>:11434/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama

# RTX 5070 Ti (16GB GDDR7) 推荐模型:
#   - 均衡高智商(强烈推荐): qwen3:14b 或 qwen2.5:14b
#   - 深度推理(带思考链):   deepseek-r1:14b
#   - 极限画质(略慢):       qwen2.5:32b-instruct-q4_K_M
LLM_MODEL=qwen3:14b
LLM_TIMEOUT_SEC=180
LLM_TEMPERATURE=0.2

# 2. GPU 计算配置
# auto = 自动检测 RTX 5070 Ti CUDA 并启用 BF16/FP32 加速; cpu = 强制 CPU
COMPUTE_DEVICE=auto
MC_SIMULATIONS=100000

# 3. SEC EDGAR 官方合规标识 (SEC 要求必须填一个有效的 User-Agent 邮箱格式，免费无需申请 Key)
SEC_USER_AGENT=FrontRunningQuantResearch/1.0 (trader@local-research.dev)

# 4. 历史行情拉取年限 (默认 10 年，用于 GPU 历史相似形态检索 & Walk-Forward 机器学习)
HISTORY_YEARS=10

# 5. 数据与数据库路径
DATA_DIR=data
REPORTS_DIR=reports
DB_PATH=data/trading_desk.db
